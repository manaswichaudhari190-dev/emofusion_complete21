# ── Database ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/emofusion

# ── Security (BUG 8 FIX) ───────────────────────────────────────────────────────
# REQUIRED — app will not start without this.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME_WITH_GENERATED_SECRET

# ── CORS (BUG 10 FIX) ─────────────────────────────────────────────────────────
# Development (comma-separated, no spaces):
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
# Production — add your deployed frontend URL(s):
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# ── Flask (BUG 9 FIX) ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# ── Face Model (EfficientViT-M5) ───────────────────────────────────────────────
# Path to the fine-tuned model checkpoint (relative to backend root)
FACE_MODEL_PATH=best_rafdb_v2_live_model.pth
